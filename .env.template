# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Instagram username used for authentication (--login-user flag).
# Required to access highlights — Instagram blocks unauthenticated requests.
INSTA_LOGIN_USER=your_instagram_username

# Seconds to sleep between slide downloads (float). Increase if you hit 429 rate limits.
# INSTA_SLEEP=1
